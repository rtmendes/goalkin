# GoalKin environment variables (docs/ARCHITECTURE.md). No values here:
# real secrets live in Infisical (project 75ce45d4-9209-45b0-a24d-a2078132f2f8, env prod)
# and are exported to .env.local by the SessionStart hook / scripts/with-env.sh.

# --- App ---
# Public base URL, no trailing slash (https in production; Google push channels require https).
NEXT_PUBLIC_APP_URL=

# --- Supabase (self-hosted at supabase.insightprofit.live) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: server only (cron, webhooks, shared views, calendar tokens, seeding). Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI plan builder ---
ANTHROPIC_API_KEY=
# Optional model override (defaults in src/lib/env.ts).
GK_AI_MODEL=

# --- Google Calendar (scope: calendar.app.created + openid email) ---
# OAuth client of type "Web application"; authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/google/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Web push (generate with: node scripts/gen-vapid.mjs) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:support@goalkin.app
VAPID_SUBJECT=

# --- Email (Resend). Without a key, emails are logged and skipped. ---
RESEND_API_KEY=
# Verified sender, e.g. GoalKin <hello@goalkin.app>
GK_EMAIL_FROM=

# --- Scheduled jobs: Vercel sends "Authorization: Bearer ${CRON_SECRET}" to /api/cron/* ---
CRON_SECRET=

# --- One-tap check-in links (HMAC key for /api/checkin?g=&d=&s=&t=) ---
CHECKIN_LINK_SECRET=

# --- Payments: GoHighLevel order forms + purchase webhook ---
GHL_WEBHOOK_SECRET=
GK_CHECKOUT_PRO_MONTHLY=
GK_CHECKOUT_PRO_YEARLY=
GK_CHECKOUT_CIRCLE=
GK_CHECKOUT_CLUB=
GK_CHECKOUT_FINISH_THE_YEAR=
GK_CHECKOUT_NEW_YEAR_RESET=

# --- Admin: comma-separated emails allowed into /admin ---
GK_ADMIN_EMAILS=

# --- Infisical machine identity (only where the SessionStart hook isn't available) ---
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
